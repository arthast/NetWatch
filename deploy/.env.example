COMPOSE_PROJECT_NAME=netwatch-prod

# Domain deploy. Caddy will use this address and enable HTTPS.
NETWATCH_SITE_ADDRESS=netwatch-arsen-demo.online
NETWATCH_HTTP_PORT=80
NETWATCH_HTTPS_PORT=443

NETWATCH_IMAGE_REGISTRY=ghcr.io/arthast/netwatch
NETWATCH_IMAGE_TAG=main

TARGET_POSTGRES_DB=target_service_db
TARGET_POSTGRES_USER=target_service
TARGET_POSTGRES_PASSWORD=change_target_password

MONITOR_POSTGRES_DB=monitor_service_db
MONITOR_POSTGRES_USER=monitor_service
MONITOR_POSTGRES_PASSWORD=change_monitor_password

ALERT_POSTGRES_DB=alert_service_db
ALERT_POSTGRES_USER=alert_service
ALERT_POSTGRES_PASSWORD=change_alert_password

NOTIFICATION_POSTGRES_DB=notification_service_db
NOTIFICATION_POSTGRES_USER=notification_service
NOTIFICATION_POSTGRES_PASSWORD=change_notification_password

AUTH_POSTGRES_DB=auth_service_db
AUTH_POSTGRES_USER=auth_service
AUTH_POSTGRES_PASSWORD=change_auth_password

# Production email provider: Yandex Cloud Postbox.
NOTIFICATION_EMAIL_PROVIDER=yandex-postbox
NOTIFICATION_EMAIL_PROVIDER_URL=https://postbox.cloud.yandex.net
NOTIFICATION_EMAIL_FROM_EMAIL=alerts@netwatch-arsen-demo.online
NOTIFICATION_EMAIL_FROM_NAME=NetWatch
NOTIFICATION_EMAIL_SEED_RECIPIENT_EMAIL=твоя_почта@example.com

AUTH_EMAIL_VERIFICATION_ENABLED=true
AUTH_EMAIL_PROVIDER=yandex-postbox
AUTH_EMAIL_PROVIDER_URL=https://postbox.cloud.yandex.net
AUTH_EMAIL_FROM_EMAIL=alerts@netwatch-arsen-demo.online
AUTH_EMAIL_FROM_NAME=NetWatch
AUTH_EMAIL_FRONTEND_BASE_URL=https://netwatch-arsen-demo.online

# IAM token should be received from VM metadata service.
# Leave YANDEX_POSTBOX_IAM_TOKEN empty in production.
YANDEX_POSTBOX_IAM_TOKEN=
NOTIFICATION_YANDEX_POSTBOX_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
AUTH_YANDEX_POSTBOX_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
